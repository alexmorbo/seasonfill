{
  // Fail CI on any advisory of "high" severity or above.
  "high": true,
  "report-type": "important",

  // Allowlist — EXACTLY ONE advisory, with justification.
  //
  // GHSA-qwww-vcr4-c8h2 — "React Router: RSC Mode CSRF Bypass Allows Action
  // Execution Before 400 Response" (react-router 7.12.0-8.2.0, via
  // react-router-dom).
  //
  // NOT REACHABLE IN THIS APP: seasonfill-web is a Vite SPA that uses
  // createBrowserRouter/RouterProvider (see src/main.tsx, src/router.tsx) —
  // client-side routing only, with NO React Server Components / RSC mode.
  // The advisory affects react-router's RSC mode exclusively, so the CSRF
  // bypass is not exploitable here. The only npm-audit "fix" is a BREAKING
  // downgrade to react-router-dom@7.11.0, which we deliberately do not take.
  //
  // TODO: drop this allowlist entry once react-router ships a non-breaking
  // patched 7.x, or the app upgrades to react-router 8.3+.
  "allowlist": ["GHSA-qwww-vcr4-c8h2"]
}
